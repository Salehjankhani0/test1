# پورت اجرای API
PORT=4000

# کلید امضای JWT — حتماً در محیط واقعی یک رشتهٔ طولانی و تصادفی بگذارید و هرگز در Frontend قرار ندهید
JWT_SECRET=change-this-to-a-long-random-secret

# مدت اعتبار توکن ورود (ثانیه) — پیش‌فرض ۳۰ روز
JWT_TTL_SECONDS=2592000

# طول دورهٔ آزمایشی رایگان (روز)
TRIAL_DAYS=10

# --- دیتابیس MySQL ---
# باید از قبل یک سرور MySQL بالا باشد و این دیتابیس در آن ساخته شده باشد، مثلاً:
#   CREATE DATABASE glass_cut CHARACTER SET utf8mb4;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=glass_cut

# --- پیامک OTP ---
# SMS_PROVIDER=console  -> فقط کد را در لاگ سرور چاپ می‌کند (برای توسعه/تست، بدون نیاز به سرویس واقعی)
# SMS_PROVIDER=kavenegar -> نیاز به KAVENEGAR_API_KEY و KAVENEGAR_TEMPLATE
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# --- CORS ---
# آدرس(های) Frontend که مجازند به این API متصل شوند (با کاما جدا کنید)
CORS_ORIGINS=http://localhost:5173
